{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "opsflow",
    "Audience": "opsflow-clients",
    "Key": "",
    "ExpiryMinutes": 30
  },
  "Security": {
    "BcryptWorkFactor": 12
  },
  "RateLimit": {
    "LoginPerMinute": 10
  },
  "Sla": {
    "WorkerEnabled": true,
    "IntervalSeconds": 60,
    "BatchSize": 500
  },
  "Platform": {
    "ApiKey": ""
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "Seed": {
    "Demo": false
  }
}
