# Copy to .env (git-ignored) and fill in. Never commit real values.

# REQUIRED. At least 32 random characters, e.g.:  openssl rand -base64 48
JWT_KEY=

# Optional. Defaults to a local-only password if unset.
POSTGRES_PASSWORD=

# DEMO ONLY. true = create two fictional companies (Acme, Globex) whose accounts all share a PUBLISHED password
# and advertise it on the login page. Never enable on an instance that holds real data or is reachable by others.
SEED_DEMO=false

# Optional (min. 16 characters). Enables POST /api/platform/tenants (create a customer). Leave empty to keep it disabled.
PLATFORM_API_KEY=
